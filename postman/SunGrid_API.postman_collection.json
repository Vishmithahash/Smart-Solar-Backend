    {
      "name": "8. Authorization Negative Tests",
      "item": [
        {
          "name": "Staff Creation by GridOperator -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{gridOperatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"forbidden@sungrid.com\",\n  \"fullName\": \"Forbidden Staff\",\n  \"role\": \"GridOperator\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/staff", "host": ["{{baseUrl}}"], "path": ["api", "users", "staff"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status code is 403', function () { pm.response.to.have.status(403); });"] } }
          ]
        },
        {
          "name": "Station Creation by Prosumer -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{prosumerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stationCode\": \"ST-FORBIDDEN\",\n  \"name\": \"Forbidden Station\",\n  \"address\": \"Colombo\",\n  \"latitude\": 6.9,\n  \"longitude\": 79.8,\n  \"capacityKwh\": 100,\n  \"totalBatteryStorageSlots\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/stations", "host": ["{{baseUrl}}"], "path": ["api", "stations"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status code is 403', function () { pm.response.to.have.status(403); });"] } }
          ]
        },
        {
          "name": "Missing JWT Authorization Header -> 401 Unauthorized",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"] } }
          ]
        },
        {
          "name": "7-Day Rule Violation Booking -> 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backofficeToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTimeUtc\": \"{{slotStartEightDaysUtc}}\",\n  \"endTimeUtc\": \"{{slotEndEightDaysUtc}}\",\n  \"totalCapacity\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/stations/{{stationId}}/slots", "host": ["{{baseUrl}}"], "path": ["api", "stations", "{{stationId}}", "slots"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"] } }
          ]
        }
      ]
    }
  ]
}
