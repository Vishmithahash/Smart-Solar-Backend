{
  "info": {
    "_postman_id": "c8f1e2a3-4b5c-6d7e-8f9a-0b1c2d3e4f5a",
    "name": "SunGrid Smart Solar Microgrid API",
    "description": "Complete Postman testing collection covering all 51 REST API endpoints across 7 controllers for SunGrid backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) {",
          "    const runId = Math.floor(1000 + Math.random() * 9000).toString();",
          "    pm.environment.set('runId', runId);",
          "}",
          "const now = new Date();",
          "const twoDays = new Date(now.getTime() + (2 * 24 * 60 * 60 * 1000));",
          "const sixDays = new Date(now.getTime() + (6 * 24 * 60 * 60 * 1000));",
          "const eightDays = new Date(now.getTime() + (8 * 24 * 60 * 60 * 1000));",
          "const nearTerm = new Date(now.getTime() + (20 * 60 * 1000));",
          "pm.environment.set('slotStartTwoDaysUtc', twoDays.toISOString());",
          "pm.environment.set('slotEndTwoDaysUtc', new Date(twoDays.getTime() + (2 * 3600 * 1000)).toISOString());",
          "pm.environment.set('slotStartSixDaysUtc', sixDays.toISOString());",
          "pm.environment.set('slotEndSixDaysUtc', new Date(sixDays.getTime() + (2 * 3600 * 1000)).toISOString());",
          "pm.environment.set('slotStartEightDaysUtc', eightDays.toISOString());",
          "pm.environment.set('slotEndEightDaysUtc', new Date(eightDays.getTime() + (2 * 3600 * 1000)).toISOString());",
          "pm.environment.set('slotStartNearTermUtc', nearTerm.toISOString());",
          "pm.environment.set('slotEndNearTermUtc', new Date(nearTerm.getTime() + (2 * 3600 * 1000)).toISOString());"
        ]
      }
    }
  ],
  "item": [
