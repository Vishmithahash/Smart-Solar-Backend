      "item": [
        {
          "name": "System Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('System is healthy', function () { const jsonData = pm.response.json(); pm.expect(jsonData.status).to.eql('Healthy'); });"
                ]
              }
            }
          ]
